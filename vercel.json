{
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "api/index.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "src": "/public/curso/(.*)", "dest": "/api/index.ts" },
    { "src": "/public/trilha/(.*)", "dest": "/api/index.ts" },
    { "src": "/login", "dest": "/api/index.ts" },
    { "src": "/$", "dest": "/api/index.ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/recover-carts",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/expire-access",
      "schedule": "0 3 * * *"
    }
  ]
}
