# Pagar.me Credentials (Get these from your dashboard at Dashboard.Pagar.me)
PAGAR_ME_SECRET_KEY=
VITE_PAGAR_ME_PUBLIC_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Focus NF — Notas Fiscais (https://focusnfe.com.br)
# Token da plataforma (usado como fallback quando recebedor não tem config própria)
FOCUS_NF_PLATFORM_TOKEN=

# Brevo (Sendinblue) — E-mails transacionais
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@suaplataforma.com.br

# Cron Jobs — Segurança dos endpoints /api/invoices/cron/*
# Gere um segredo aleatório: openssl rand -hex 32
CRON_SECRET=
